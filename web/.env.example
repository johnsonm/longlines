# Copy to .env.local for local development. Values from `supabase start` (local)
# or the project's API settings (hosted). Either naming works; the Supabase
# Vercel integration sets SUPABASE_URL and SUPABASE_ANON_KEY automatically.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Shown in the callsign profile footer as the address for hiding a profile.
# Optional; without it the footer leaves that sentence out.
VITE_CONTACT_EMAIL=
