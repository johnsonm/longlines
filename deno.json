{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "nodeModulesDir": "none",
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/yaml": "jsr:@std/yaml@1",
    "hyparquet-writer": "npm:hyparquet-writer@0.16.10",
    "hyparquet": "npm:hyparquet@1.31.1",
    "postgres": "npm:postgres@3.4.9",
    "zod": "npm:zod@4.6.7"
  },
  "tasks": {
    "test": "deno test -P supabase/functions/_shared/__tests__/ relay/__tests__/ sender/__tests__/",
    "check": "deno check supabase/functions/*/index.ts relay/main.ts sender/main.ts",
    "lint": "deno lint supabase/functions scripts relay sender",
    "fmt": "deno fmt supabase/functions scripts relay sender deno.json",
    "coverage": "rm -rf coverage && deno test -P --coverage=coverage supabase/functions/_shared/__tests__/ relay/__tests__/ sender/__tests__/ && deno coverage --exclude=__tests__ coverage && deno coverage --lcov --output=coverage/lcov.info --exclude=__tests__ coverage && deno run --allow-read scripts/check-coverage.ts coverage/lcov.info 80"
  },
  "lint": {
    "exclude": [
      "deno.d.ts",
      "node_modules/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "exclude": [
      "deno.d.ts",
      "node_modules/"
    ],
    "lineWidth": 100
  },
  "permissions": {
    "default": {
      "net": [
        "127.0.0.1"
      ],
      "env": [
        "LONGLINES_USER_AGENT_URL",
        "SENDER_TEST_DATABASE_URL",
        "PROFILE_LOCK_TEST_DATABASE_URL",
        "PGAPPNAME",
        "PGTARGETSESSIONATTRS"
      ],
      "run": [
        "deno"
      ],
      "read": [
        "docs/openapi.yaml",
        "supabase/functions",
        "supabase/config.toml",
        "supabase/migrations",
        "deno.json",
        "relay/Dockerfile",
        "relay/deno.json",
        "sender/Dockerfile",
        "sender/deno.json"
      ]
    }
  }
}
